# Copy to .env and fill in. Never commit .env.
# One NAME=value per line, no quotes and no spaces around "=". A # starts a comment, so no value may contain #.
# Comments go on their own line: systemd (way B in DEPLOY.md) would take a "# …" after a value as part of it.
# Save it as UTF-8 (Notepad does). On Windows, not with PowerShell's > or >>, which write UTF-16.

# A live server. This also makes "npm run seed" refuse to add the demo accounts.
NODE_ENV=production

# The web address people use (a DNS A/AAAA record must point it at this server)
DOMAIN=programo.example.com
# Used by "npm run reset-link" to print full links
PUBLIC_URL=https://programo.example.com

# Optional. Two-factor secrets and SMS tokens are encrypted with this. Leave it empty and a random
# key is created once in the data folder (.secret) — that is fine. If you set it: long and random
# (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"), set it before
# the first start, and never change it afterwards, or those encrypted fields can no longer be read.
APP_SECRET=

# Optional: other sites allowed to send changes to the API (comma separated). Normally empty.
ALLOWED_ORIGINS=

# Only when running without Docker (the Linux service in deploy/programo.service already sets these):
# PORT=3000
# With a proxy on the same machine (Caddy, tailscale serve), listen only locally:
# HOST=127.0.0.1
# DATA_DIR=/var/lib/programo
# Empty = trust only a proxy on this same machine (right for Caddy on localhost):
# TRUST_PROXY=
